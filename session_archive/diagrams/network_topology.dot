digraph network_topology {
  graph [bgcolor="black" rankdir=LR fontname="Courier New"
         label="session_archive — network topology (all localhost, zero WAN exposure)"
         labelloc=t fontcolor="#00FF41" fontsize=15 pad=0.5 nodesep=0.5];
  node  [style=filled fillcolor="#0a0a0a" fontname="Courier New" fontsize=10 penwidth=2.0];
  edge  [fontname="Courier New" fontsize=9 penwidth=2.0];

  subgraph cluster_scripts {
    label="session_archive scripts (local process)"; fontcolor="#00FFFF"; color="#00FFFF"; style=dashed;
    scripts [label="ingest_sessions.py\nquery_sessions.py\nlabel_sessions.py" color="#00FFFF" fontcolor="#00FFFF" shape=box];
  }

  subgraph cluster_local {
    label="localhost-only (127.0.0.1)"; fontcolor="#7FFF00"; color="#7FFF00"; style=dashed;
    neo4j  [label="paper-processor-neo4j\nbolt :7687 / http :7474" color="#7FFF00" fontcolor="#7FFF00" shape=doubleoctagon];
    ollama [label="Ollama\nhttp :11434" color="#7FFF00" fontcolor="#7FFF00" shape=doubleoctagon];
  }

  subgraph cluster_outbound {
    label="Outbound-only, first-run only"; fontcolor="#FFFF00"; color="#FFFF00"; style=dashed;
    hfhub [label="huggingface.co\nbge-m3 model download\n(~2GB, cached after)" color="#FFFF00" fontcolor="#FFFF00" shape=hexagon];
  }

  subgraph cluster_wan {
    label="WAN — not applicable"; fontcolor="#FF3333"; color="#FF3333"; style=dashed;
    noexposure [label="NO listening port,\nNO UFW rule,\nNO cloudflared tunnel\nfor session_archive itself" color="#FF3333" fontcolor="#FF3333" shape=plaintext];
  }

  scripts -> neo4j  [color="#7FFF00" label="bolt, localhost"];
  scripts -> ollama [color="#7FFF00" label="http, localhost"];
  scripts -> hfhub  [color="#FFFF00" label="https, outbound,\nonce per model"];
  scripts -> noexposure [color="#FF3333" style=dashed label="(this box's :8686/:8585\ndashboards already expose\nthe graph on the LAN —\nsession_archive adds no\nnew listening surface)"];
}
