digraph catch22s {
  graph [bgcolor="black" rankdir=TB fontname="Courier New"
         label="session_archive — catch-22s hit building this"
         labelloc=t fontcolor="#00FF41" fontsize=16 pad=0.5 nodesep=0.5 ranksep=0.4];
  node  [style=filled fillcolor="#0a0a0a" fontname="Courier New" fontsize=10 penwidth=2.0 shape=box];
  edge  [fontname="Courier New" fontsize=9 penwidth=2.0];

  subgraph cluster_order {
    label="Ordering dependencies"; fontcolor="#FF6600"; color="#FF6600"; style=dashed;
    c1a [label="ingest_sessions.py needs\npaper-processor-neo4j\nUP first" color="#FF6600" fontcolor="#FF6600"];
    c1b [label="--rerank needs a probe" color="#FF6600" fontcolor="#FF6600"];
    c1c [label="probe needs\nlabel_sessions.py run" color="#FF6600" fontcolor="#FF6600"];
    c1d [label="label_sessions.py needs\nid_map.json to exist" color="#FF6600" fontcolor="#FF6600"];
    c1e [label="id_map.json needs a\ncompleted ingest run first" color="#FF6600" fontcolor="#FF6600"];
    c1a -> c1e [style=invis];
    c1b -> c1c -> c1d -> c1e [color="#FF6600" dir=back];
  }

  subgraph cluster_env {
    label="Environment surprises"; fontcolor="#FF3333"; color="#FF3333"; style=dashed;
    c2a [label="/mnt/nvme_staging is\nroot-owned by default —\nneeded sudo mkdir+chown\nonce before first write" color="#FF3333" fontcolor="#FF3333"];
    c2b [label="bge-m3's first download\nis ~2GB from HF Hub —\nlooks like a silent hang\nif you don't expect it" color="#FF3333" fontcolor="#FF3333"];
    c2c [label="pip installing faiss-cpu\ninto paper_processor's venv\ncan trigger a cuda-toolkit\nversion warning against the\nexisting RAPIDS stack —\nharmless, both still import" color="#FF3333" fontcolor="#FF3333"];
  }

  subgraph cluster_git {
    label="Shared repo surprises"; fontcolor="#FFFF00"; color="#FFFF00"; style=dashed;
    c3a [label="paper_processor has other\nactive contributors\n(e.g. dellt3600) — a plain\ngit push can be rejected" color="#FFFF00" fontcolor="#FFFF00"];
    c3b [label="fix: always\ngit fetch && git log\nHEAD..origin/main\nbefore pushing" color="#FFFF00" fontcolor="#FFFF00"];
    c3a -> c3b [color="#FFFF00"];
  }
}
