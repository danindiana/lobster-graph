digraph future {
  graph [bgcolor="black" rankdir=LR fontname="Courier New"
         label="session_archive — Future Directions Roadmap"
         labelloc=t fontcolor="#00FF41" fontsize=17 pad=0.5 ranksep=0.9 nodesep=0.3];
  node  [style=filled fillcolor="#0a0a0a" fontname="Courier New" fontsize=10 penwidth=2.0 shape=box];
  edge  [style=invis];

  subgraph cluster_done {
    label="✓ Shipped"; fontcolor="#00FF41"; color="#00FF41"; style=dashed;
    d1 [label="ingest: Ollama summary\n+ concepts + bge-m3 chunks" color="#00FF41" fontcolor="#00FF41"];
    d2 [label="query: FAISS top-k\n+ related Concepts" color="#00FF41" fontcolor="#00FF41"];
    d3 [label="--like: session-to-session\nsimilarity search" color="#00FF41" fontcolor="#00FF41"];
    d4 [label="--rerank: persistent\nMLP relevance probe" color="#00FF41" fontcolor="#00FF41"];
    d5 [label="idempotent, resumable\ningestion + checkpointing" color="#00FF41" fontcolor="#00FF41"];
  }

  subgraph cluster_soon {
    label="Proposed — next"; fontcolor="#FFFF00"; color="#FFFF00"; style=dashed;
    n1 [label="Rocchio-style ephemeral\nfeedback as a --rerank\nalternative (no training loop,\nper-query instead of corpus-wide)" color="#FFFF00" fontcolor="#FFFF00"];
    n2 [label="cross-corpus Concept\nlinking to AI/ML papers\n(already share the label\nautomatically — needs\na browsing UI)" color="#FFFF00" fontcolor="#FFFF00"];
    n3 [label=":8686 dashboard\nclick-to-open-source\nfor Session nodes\n(currently Paper-only)" color="#FFFF00" fontcolor="#FFFF00"];
  }

  subgraph cluster_later {
    label="Proposed — later / at scale"; fontcolor="#FF6600"; color="#FF6600"; style=dashed;
    l1 [label="FAISS IVF/HNSW\nif corpus grows past\n~10K chunks (currently 705\n— flat index still fine)" color="#FF6600" fontcolor="#FF6600"];
    l2 [label="image-modality support\n(screenshots, diagrams —\nmilitia-classifier's CLIP\npattern, not ported yet)" color="#FF6600" fontcolor="#FF6600"];
    l3 [label=":8585 webgl.html\nSession support\n(currently AI-ML_Papers-\ncoupled)" color="#FF6600" fontcolor="#FF6600"];
  }

  d1 -> n1 [style=invis]; d2 -> n2 [style=invis]; d3 -> n3 [style=invis];
  n1 -> l1 [style=invis]; n2 -> l2 [style=invis]; n3 -> l3 [style=invis];
}
