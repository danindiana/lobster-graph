digraph portability {
  graph [bgcolor="black" rankdir=LR fontname="Courier New"
         label="session_archive — what's worlock-specific vs portable"
         labelloc=t fontcolor="#00FF41" fontsize=16 pad=0.5 nodesep=0.4];
  node  [style=filled fillcolor="#0a0a0a" fontname="Courier New" fontsize=10 penwidth=2.0 shape=box];
  edge  [style=invis];

  subgraph cluster_hardcoded {
    label="Hardcoded / worlock-specific"; fontcolor="#FF3333"; color="#FF3333"; style=dashed;
    h1 [label="NEO4J_URI default\nbolt://localhost:7687" color="#FF3333" fontcolor="#FF3333"];
    h2 [label="index-dir default\n/mnt/nvme_staging/\nsession_archive_index" color="#FF3333" fontcolor="#FF3333"];
    h3 [label="ingest model default\nqwen3:14b\n(assumes it's pulled)" color="#FF3333" fontcolor="#FF3333"];
    h4 [label="corpus root default\n~/Documents/claude_creations" color="#FF3333" fontcolor="#FF3333"];
    h5 [label="Neo4j password\nhardcoded default\npassword123" color="#FF3333" fontcolor="#FF3333"];
  }

  subgraph cluster_howtofix {
    label="Change via env var / flag"; fontcolor="#FFFF00"; color="#FFFF00"; style=dashed;
    f1 [label="NEO4J_URI / NEO4J_USER /\nNEO4J_PASSWORD env vars" color="#FFFF00" fontcolor="#FFFF00"];
    f2 [label="--index-dir flag\n(any writable path)" color="#FFFF00" fontcolor="#FFFF00"];
    f3 [label="--model flag\n(any pulled Ollama model)" color="#FFFF00" fontcolor="#FFFF00"];
    f4 [label="--root flag\n(any dated-folder corpus)" color="#FFFF00" fontcolor="#FFFF00"];
    f5 [label="NEO4J_PASSWORD env var\n(still plaintext default\nif unset — see catch22s)" color="#FFFF00" fontcolor="#FFFF00"];
  }

  subgraph cluster_portable {
    label="Portable as-is"; fontcolor="#00FF41"; color="#00FF41"; style=dashed;
    p1 [label="GPU auto-pick\n_pick_device() probes\nfree VRAM, falls back\nto CPU" color="#00FF41" fontcolor="#00FF41"];
    p2 [label="bge-m3 embedding\nmodel — CPU-capable,\nno GPU required" color="#00FF41" fontcolor="#00FF41"];
    p3 [label="FAISS IndexFlatIP\n— pure CPU, no\nGPU/CUDA dependency" color="#00FF41" fontcolor="#00FF41"];
    p4 [label="Neo4j MERGE writer\n— idempotent, safe\nto point at any\npaper-processor-neo4j" color="#00FF41" fontcolor="#00FF41"];
  }

  h1 -> f1; h2 -> f2; h3 -> f3; h4 -> f4; h5 -> f5;
}
