digraph DataModel {
    bgcolor="#050510";
    node [style=filled, fontname="Courier New", shape=record, color="#00ffff", fillcolor="#0a0a2a", fontcolor="#ff00ff"];
    edge [color="#ff00aa", fontname="Courier New", fontcolor="#00ff00"];

    SessionNode [label="{ <f0> (:Session) | path: String\l | title: String\l | slug: String\l | date: String\l | summary: String\l }"];
    ConceptNode [label="{ <f0> (:Concept) | name: String\l | definition: String\l }"];
    
    SessionNode:f0 -> ConceptNode:f0 [label=" [:MENTIONS] "];

    FAISSIndex [label="{ <f0> FAISS IndexFlatIP | Tensor[N, 1024] float32\l | Inner Product Metric\l }"];
    IDMap [label="{ <f0> id_map.json (Array) | session: String\l | path: String\l | chunk_idx: Integer\l | snippet: String\l }"];
    IngestedMap [label="{ <f0> ingested_sessions.json | Key: slug (String)\l | processed_at: ISO8601\l | chunks: Integer\l }"];

    IDMap:f0 -> FAISSIndex:f0 [label=" Maps index 'i' to vector 'i' ", style=dashed];
    SessionNode:f0 -> IDMap:f0 [label=" slug match ", style=dotted, color="#ffff00"];
    IngestedMap:f0 -> SessionNode:f0 [label=" prevents duplicate upsert ", style=dashed, color="#00ff00"];
}
