digraph SystemArchitecture {
    rankdir=LR;
    bgcolor="#0a0a0a";
    node [style=filled, fontname="Courier New", shape=box, color="#ff00ff", fillcolor="#1a1a1a", fontcolor="#00ffff"];
    edge [color="#00ff00", fontname="Courier New", fontcolor="#ffff00"];

    subgraph cluster_0 {
        label = "File System (The Source)";
        color = "#ff00ff";
        fontcolor = "#ff00ff";
        Docs [label="Markdown Docs\n(~/Documents/claude_creations)"];
        Heuristics [label="find_primary_doc()"];
        Docs -> Heuristics [label="Regex Filtering"];
    }

    subgraph cluster_1 {
        label = "Macro Extraction (Ollama API)";
        color = "#00ffff";
        fontcolor = "#00ffff";
        Prompting [label="SUMMARY_PROMPT\n(Truncated to 16K chars)"];
        LLM [label="qwen3:14b LLM\n(Inference Engine)"];
        Parser [label="clean_markdown_headers()\nparse_logic_definitions()"];
        Heuristics -> Prompting;
        Prompting -> LLM [label="HTTP POST /api/generate"];
        LLM -> Parser [label="Markdown Stream"];
    }

    subgraph cluster_2 {
        label = "Micro Extraction (PyTorch/FAISS)";
        color = "#00ff00";
        fontcolor = "#00ff00";
        Chunker [label="chunk_text()\n(4000 chars, 200 overlap)"];
        DevicePicker [label="pick_device()\n(CUDA VRAM Allocation)"];
        Encoder [label="BAAI/bge-m3\n(SentenceTransformer)"];
        Heuristics -> Chunker;
        DevicePicker -> Encoder [label="Pins Tensors"];
        Chunker -> Encoder [label="Batch Encoding"];
    }

    subgraph cluster_3 {
        label = "Dual Persistence Layer";
        color = "#ffff00";
        fontcolor = "#ffff00";
        Neo4j [label="Neo4j Graph Database\n(Bolt Protocol)", shape=cylinder, fillcolor="#2a2a00", color="#ffff00"];
        FAISS [label="FAISS IndexFlatIP\n+ JSON Sidecars", shape=cylinder, fillcolor="#2a2a00", color="#ffff00"];
        
        Parser -> Neo4j [label="Cypher MERGE\nSession & Concept Nodes"];
        Encoder -> FAISS [label="numpy float32 L2-Norm Embeddings"];
    }
}
