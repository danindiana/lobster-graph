digraph session_archive_ingestion {
  graph [bgcolor="black" rankdir=LR fontname="Courier New"
         label="session_archive/ingest_sessions.py — claude_creations → Neo4j + FAISS"
         labelloc=t fontcolor="#00FF41" fontsize=16 pad=0.5];
  node  [style=filled fillcolor="#0a0a0a" fontname="Courier New"
         fontsize=11 penwidth=2.0];
  edge  [fontname="Courier New" fontsize=10 penwidth=2.0];

  subgraph cluster_source {
    label="claude_creations/*/"; fontcolor="#FF00FF"; color="#FF00FF"; style=dashed;
    folders [label="292 dated session folders\n(SESSION.md / README.md / *.md)" color="#FF00FF" fontcolor="#FF00FF" shape=folder];
  }

  subgraph cluster_discover {
    label="File Discovery"; fontcolor="#00FFFF"; color="#00FFFF"; style=dashed;
    finddoc [label="find_primary_doc()\nSESSION.md → README.md → first *.md" color="#00FFFF" fontcolor="#00FFFF" shape=component];
  }

  subgraph cluster_llm {
    label="Ollama — qwen3:14b"; fontcolor="#FFFF00"; color="#FFFF00"; style=dashed;
    ollama [label="call_ollama()\nSUMMARY_PROMPT, first 16K chars\nnum_ctx=8192" color="#FFFF00" fontcolor="#FFFF00" shape=box];
  }

  subgraph cluster_parse {
    label="Markdown Parsing (reused)"; fontcolor="#FF6600"; color="#FF6600"; style=dashed;
    parse [label="clean_markdown_headers()\nparse_logic_definitions()\n(from neo4j_importer.py)" color="#FF6600" fontcolor="#FF6600" shape=box];
  }

  subgraph cluster_embed {
    label="Chunk + Embed (GPU)"; fontcolor="#7FFF00"; color="#7FFF00"; style=dashed;
    chunk [label="chunk_text()\n4000 chars / 200 overlap\nfull document" color="#7FFF00" fontcolor="#7FFF00" shape=box];
    bge   [label="BAAI/bge-m3\nsentence-transformers\n_pick_device() → cuda:N or cpu" color="#7FFF00" fontcolor="#7FFF00" shape=box3d];
  }

  subgraph cluster_faiss {
    label="Vector Store"; fontcolor="#FF3333"; color="#FF3333"; style=dashed;
    faiss [label="FAISS IndexFlatIP\n/mnt/nvme_staging/\nsession_archive_index/" color="#FF3333" fontcolor="#FF3333" shape=cylinder];
    idmap [label="id_map.json\nchunk → (session, path, idx)" color="#FF3333" fontcolor="#FF3333" shape=note];
  }

  subgraph cluster_neo4j {
    label="paper-processor-neo4j (Docker)"; fontcolor="#00FF41"; color="#00FF41"; style=dashed;
    session [label="MERGE (s:Session\n{title, path, date, summary})" color="#00FF41" fontcolor="#00FF41" shape=doubleoctagon];
    concept [label="MERGE (c:Concept {name})\nshared with Paper nodes" color="#00FF41" fontcolor="#00FF41" shape=doubleoctagon];
    mentions [label="MERGE (s)-[:MENTIONS]->(c)" color="#00FF41" fontcolor="#00FF41" shape=cylinder];
  }

  folders -> finddoc [color="#FF00FF"];
  finddoc -> ollama  [color="#00FFFF" label="raw text\n(prompt-capped 16K)"];
  finddoc -> chunk   [color="#00FFFF" label="raw text\n(full, uncapped)"];

  ollama -> parse [color="#FFFF00" label="## Summary\n## Concepts"];
  parse  -> session  [color="#FF6600" label="summary"];
  parse  -> concept  [color="#FF6600" label="concept name\n+ definition"];

  chunk -> bge  [color="#7FFF00" label="chunks[]"];
  bge   -> faiss [color="#7FFF00" label="normalized vectors"];
  bge   -> idmap [color="#7FFF00"];

  session -> mentions [color="#00FF41"];
  concept -> mentions [color="#00FF41"];
}
