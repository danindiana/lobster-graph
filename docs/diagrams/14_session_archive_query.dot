digraph session_archive_query {
  graph [bgcolor="black" rankdir=LR fontname="Courier New"
         label="session_archive/query_sessions.py — semantic search over the archive"
         labelloc=t fontcolor="#00FF41" fontsize=16 pad=0.5];
  node  [style=filled fillcolor="#0a0a0a" fontname="Courier New"
         fontsize=11 penwidth=2.0];
  edge  [fontname="Courier New" fontsize=10 penwidth=2.0];

  subgraph cluster_cli {
    label="CLI"; fontcolor="#FF00FF"; color="#FF00FF"; style=dashed;
    query [label="query_sessions.py \"<question>\"\n--top-k N" color="#FF00FF" fontcolor="#FF00FF" shape=note];
  }

  subgraph cluster_embed {
    label="Embed (GPU)"; fontcolor="#00FFFF"; color="#00FFFF"; style=dashed;
    bge [label="BAAI/bge-m3\nsame model as ingest\nnormalize_embeddings=True" color="#00FFFF" fontcolor="#00FFFF" shape=box3d];
  }

  subgraph cluster_faiss {
    label="Vector Search"; fontcolor="#FFFF00"; color="#FFFF00"; style=dashed;
    faiss  [label="index.faiss\nIndexFlatIP.search(top_k)" color="#FFFF00" fontcolor="#FFFF00" shape=cylinder];
    idmap  [label="id_map.json\nvector idx → (session, path, snippet)" color="#FFFF00" fontcolor="#FFFF00" shape=note];
  }

  subgraph cluster_neo4j {
    label="paper-processor-neo4j (optional context)"; fontcolor="#7FFF00"; color="#7FFF00"; style=dashed;
    related [label="related_concepts()\nMATCH (s:Session)-[:MENTIONS]->(c)\nLIMIT 5" color="#7FFF00" fontcolor="#7FFF00" shape=doubleoctagon];
  }

  subgraph cluster_out {
    label="Output"; fontcolor="#FF3333"; color="#FF3333"; style=dashed;
    results [label="ranked matches\nscore + session + snippet\n+ related concepts" color="#FF3333" fontcolor="#FF3333" shape=box];
  }

  query -> bge   [color="#FF00FF" label="qvec = encode(query)"];
  bge   -> faiss [color="#00FFFF" label="cosine via\nnormalized inner product"];
  faiss -> idmap [color="#FFFF00" label="top-k indices"];
  idmap -> results [color="#FFFF00" label="snippet + path"];
  idmap -> related [color="#FFFF00" label="path\n(per unique session)" style=dashed];
  related -> results [color="#7FFF00" label="concept names"];
}
