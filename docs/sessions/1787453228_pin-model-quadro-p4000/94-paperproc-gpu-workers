#!/bin/bash
# paper_proc dual-GPU worker status — motd entry.
# Added 2026-08-22 when a second worker (Quadro P4000, GPU0) was stood up
# alongside the original GTX 1060 (GPU1) worker to roughly double
# papers/hour throughput. See:
#   ~/programs/paper_proc/docs/sessions/1787167674_pin-model-gtx1060/
#   ~/programs/paper_proc/docs/sessions/1787453228_pin-model-quadro-p4000/
# Kept dynamic (checks live process/port state) rather than a static blurb,
# so this doesn't go stale like a one-off `wall` message would.

GREEN='\033[1;32m'; ORANGE='\033[1;33m'; CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'

worker_count=$(pgrep -f 'paper_proc_smrtevict.py' 2>/dev/null | wc -l)
model=$(ps -eo args 2>/dev/null | grep -oP 'paper_proc_smrtevict\.py.*--model \K\S+' | sort -u | head -1)

gpu1_backend="stopped"; ss -tln 2>/dev/null | grep -q ':11435 ' && gpu1_backend="up"
gpu0_backend="stopped"; ss -tln 2>/dev/null | grep -q ':11436 ' && gpu0_backend="up"

echo ""
echo -e "${BOLD}${CYAN}paper_proc${RESET} dual-GPU batch workers (~/programs/paper_proc)"
echo -e "  Model         : ${model:-gemma4:e2b-it-qat} on both GPUs (kept identical for uniform output quality)"

if [[ "$gpu1_backend" == "up" ]]; then
    echo -e "  GPU1 (1060)   : ${GREEN}backend up${RESET}   127.0.0.1:11435"
else
    echo -e "  GPU1 (1060)   : ${ORANGE}backend down${RESET} → ~/programs/paper_proc/docs/sessions/1787167674_pin-model-gtx1060/start_gpu1_backend.sh"
fi
if [[ "$gpu0_backend" == "up" ]]; then
    echo -e "  GPU0 (P4000)  : ${GREEN}backend up${RESET}   127.0.0.1:11436"
else
    echo -e "  GPU0 (P4000)  : ${ORANGE}backend down${RESET} → ~/programs/paper_proc/docs/sessions/1787453228_pin-model-quadro-p4000/start_gpu0_backend.sh"
fi

if [[ "$worker_count" -ge 2 ]]; then
    echo -e "  Workers       : ${GREEN}${worker_count} running${RESET} (expect 2 — one per GPU; per-paper .processing.lock prevents overlap)"
elif [[ "$worker_count" -eq 1 ]]; then
    echo -e "  Workers       : ${ORANGE}only 1 running${RESET} (expect 2 — the other GPU's batch isn't launched)"
else
    echo -e "  Workers       : ${ORANGE}none running${RESET}"
fi
echo -e "  Logs          : ~/programs/paper_proc/logs/smrtevict_*.log"
echo ""
