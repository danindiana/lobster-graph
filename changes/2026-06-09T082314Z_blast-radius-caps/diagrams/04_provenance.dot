// Provenance: from the failing run through diagnosis, fixes, commits, and push.
digraph provenance {
  rankdir=LR;
  bgcolor="#06090f";
  pad=0.4; nodesep=0.35; ranksep=0.75;
  node [shape=box, style="rounded,filled", fontname="Courier", fontsize=10,
        color="#5fffcf", fillcolor="#0d141d", fontcolor="#cfe", penwidth=1.6];
  edge [color="#2c4a5a", fontname="Courier", fontsize=9, fontcolor="#66aa88", penwidth=1.4];

  label="Provenance — 2026-06-09 · worlock";
  labelloc="t"; fontname="Courier"; fontcolor="#5fffcf"; fontsize=15;

  run  [label="run: 5208 ✅ / 11 ❌\nHTTP 500 runner-OOM", color="#ff6b6b", fontcolor="#ff6b6b"];
  inv  [label="investigate\nollama log + /proc + nvidia-smi", color="#ffd45f", fontcolor="#ffd45f"];
  diag [label="diagnosis:\nGPU1 8.26 > 8.2 GiB\n+ two 30B models", color="#ff6b6b", fontcolor="#ff6b6b"];

  c12  [label="commit aed7463\n1 · select_model >200→14B\n2 · --ocr-max-pages=40", color="#9affae", fontcolor="#9affae"];
  c34  [label="commit c823b7d\n3 · code_model→14B coder\n4 · context 90k→45k", color="#9affae", fontcolor="#9affae"];

  rec  [label="record subfolder\nchanges/…_blast-radius-caps/\npatch + copies + README + diagrams",
        color="#7ab8ff", fontcolor="#7ab8ff"];
  push [label="rebase onto origin/main\npush → danindiana/lobster-graph",
        color="#5fffcf", fontcolor="#5fffcf", penwidth=2.2];
  restart [label="restart (separate instance)\npicks up working-tree fixes",
        color="#ffa45f", fontcolor="#ffa45f"];

  run -> inv -> diag;
  diag -> c12 -> c34;
  c34 -> rec -> push -> restart;
}
