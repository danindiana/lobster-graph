// Architecture: how a PDF now flows through the capped pipeline.
digraph routing {
  rankdir=TB;
  bgcolor="#06090f";
  pad=0.4; nodesep=0.4; ranksep=0.7;
  node [shape=box, style="rounded,filled", fontname="Courier", fontsize=11,
        color="#5fffcf", fillcolor="#0d141d", fontcolor="#cfe", penwidth=1.6];
  edge [color="#2c4a5a", fontname="Courier", fontsize=9, fontcolor="#66aa88", penwidth=1.4];

  label="Capped pipeline — PDF → sized model + bounded OCR + bounded context";
  labelloc="t"; fontname="Courier"; fontcolor="#5fffcf"; fontsize=15;

  pdf  [label="PDF", color="#9affae", fontcolor="#9affae", penwidth=2.2];
  ocr  [label="extract_pages_with_ocr\nmax_ocr_pages=40", color="#ffd45f", fontcolor="#ffd45f"];
  pc   [label="page_count", shape=diamond, color="#7ab8ff", fontcolor="#7ab8ff"];

  m_fast [label="≤8pg → deepseek-r1:8b", color="#7aa0c0", fontcolor="#7aa0c0"];
  m_sing [label="≤18pg → deepseek-r1:14b", color="#7aa0c0", fontcolor="#7aa0c0"];
  m_xl   [label="19–200pg → nemotron-3-nano-30b", color="#ff7ad9", fontcolor="#ff7ad9"];
  m_big  [label=">200pg → deepseek-r1:14b\n(was nemotron-30b)", color="#9affae", fontcolor="#9affae", penwidth=2.2];

  ctx  [label="map_reduce → context\ncapped[:45_000]  (~11k tok)\ndiagrams capped[:30_000]",
        color="#ffd45f", fontcolor="#ffd45f"];
  code [label="C++ section\nqwen2.5-coder:14b\n(was qwen3-coder:30b)", color="#9affae", fontcolor="#9affae", penwidth=2.2];

  out  [label="_processed/ bundle\n01_summary · 02_logic · 03_cpp\ndiagrams · 04_extras · metadata.json",
        color="#ffa45f", fontcolor="#ffa45f", penwidth=2.0];

  pdf -> ocr -> pc;
  pc -> m_fast; pc -> m_sing; pc -> m_xl; pc -> m_big;
  m_fast -> ctx; m_sing -> ctx; m_xl -> ctx; m_big -> ctx;
  ctx -> code [label="cpp uses 14B coder"];
  ctx -> out; code -> out;
}
