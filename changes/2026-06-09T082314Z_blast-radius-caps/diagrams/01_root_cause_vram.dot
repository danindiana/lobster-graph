// Root cause: the two 30B models oversubscribe the dual-GPU VRAM, so a larger
// KV cache (longer context) tips GPU1 past its limit and the runner OOM-crashes.
digraph root_cause {
  rankdir=LR;
  bgcolor="#06090f";
  pad=0.4;
  node [shape=box, style="rounded,filled", fontname="Courier", fontsize=11,
        color="#5fffcf", fillcolor="#0d141d", fontcolor="#cfe", penwidth=1.6];
  edge [color="#2c4a5a", fontname="Courier", fontsize=9, fontcolor="#66aa88", penwidth=1.4];

  label="Root cause — VRAM exhaustion → llama-runner OOM (HTTP 500)";
  labelloc="t"; fontname="Courier"; fontcolor="#5fffcf"; fontsize=15;

  subgraph cluster_models {
    label="loaded models (OLLAMA_MAX_LOADED_MODELS=2)";
    color="#116633"; fontcolor="#77aaaa"; fontname="Courier"; fontsize=10;
    nem  [label="nemotron-3-nano-30b\nprose sections", color="#ff7ad9", fontcolor="#ff7ad9"];
    qwen [label="qwen3-coder:30b\nC++ section", color="#ff7ad9", fontcolor="#ff7ad9"];
  }

  subgraph cluster_gpu0 {
    label="GPU0 · RTX 5080 · 15.0 GiB avail";
    color="#116633"; fontcolor="#7ab8ff"; fontname="Courier"; fontsize=10;
    g0 [label="weights 13.4\n+ kv 0.82  + graph 0.54\n= 14.76 GiB  (tight)",
        color="#7ab8ff", fontcolor="#7ab8ff"];
  }
  subgraph cluster_gpu1 {
    label="GPU1 · RTX 3080 · 8.2 GiB avail";
    color="#116633"; fontcolor="#ff6b6b"; fontname="Courier"; fontsize=10;
    g1 [label="weights 7.7\n+ kv 0.37  + graph 0.19\n= 8.26 GiB  ⚠ OVER",
        color="#ff6b6b", fontcolor="#ff6b6b", penwidth=2.4];
  }

  ctx  [label="long context\n(90k chars ≈ 22k tok)\noverflows 16k window", color="#ffd45f", fontcolor="#ffd45f"];
  kv   [label="KV cache grows", color="#ffd45f", fontcolor="#ffd45f"];
  oom  [label="CUDA alloc fails\n→ runner terminated", color="#ff6b6b", fontcolor="#ff6b6b", penwidth=2.4];
  err  [label="HTTP 500\n\"resource limitations\"\n11 / 5219 papers", color="#ff6b6b", fontcolor="#ff6b6b", penwidth=2.4];

  nem  -> g0 [label="split"];
  nem  -> g1 [label="split"];
  qwen -> g1 [label="2nd 30B\nthrash", style=dashed, color="#ff6b6b"];
  ctx  -> kv -> g1 [label="tips over"];
  g1   -> oom -> err;
}
